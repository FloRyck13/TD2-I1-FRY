def decoder_cesar(chemin):
    flux=open(chemin,"r")
    texte=flux.read()
    flux.close()
    resultat = subprocess.run(
        ["tr", "D-ZABCd-zabc", "a-zA-Z"],
        input=texte,
        capture_output=True,
        text=True
    )

    return resultat.stdout

print(decoder_cesar("extraits/secret1")) #lecture d'un fichier

