# Question 1 :

import csv

def read_csv(path):
    fichier = open(path, encoding="utf-8")
    lecteur = csv.reader(fichier, delimiter=";")
    data = list(lecteur)
    fichier.close()
    return data

# Question 2 :

def convertir(valeur):
    valeur = valeur.replace("%", "").replace("*", "")
    return float(valeur) / 100

def structurer_reference_freqs(data):
    langues = data[0][1:]
    dicos_langues = {}               # un dictionnaire par langue
    for i in range(len(langues)):
        dicos_langues.append({})

    for l in range(1, len(data)):    # on saute la ligne d'en-tête
        lettre = data[l][0]
        for f in range(1, len(data[l])):
            dicos_langues[f - 1][lettre] = convertir(data[l][f])

    ref = {}
    for i in range(len(langues)):
        ref[langues[i]] = dicos[i]
    return ref
