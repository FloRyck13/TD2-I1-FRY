# Question 1 :

import csv

def read_csv(path):
    fichier = open(path, encoding="utf-8")
    lecteur = csv.reader(fichier, delimiter=";")
    data = list(lecteur)
    fichier.close()
    return data

# Question 2 :

def convertir(valeur):
    valeur = valeur.replace("%", "").replace("*", "")
    return float(valeur) / 100

def structurer_reference_freqs(data):
    langues = data[0][1:]
    dicos_langues = {}               # un dictionnaire par langue
    for i in range(len(langues)):
        dicos_langues.append({})

    for l in range(1, len(data)):    # on saute la ligne d'en-tête
        lettre = data[l][0]
        for f in range(1, len(data[l])):
            dicos_langues[f - 1][lettre] = convertir(data[l][f])

    ref = {}
    for i in range(len(langues)):
        ref[langues[i]] = dicos[i]
    return ref

# Question 3 :

def compter_occurences(chemin) :
    flux=open(chemin,"r")
    texte=flux.read()
    flux.close()
    occurrences = {}
    total = 0
    for c in texte :
        if c in occurrences:
            occurrences[c] += 1
        else:
            occurrences[c] = 1
        total += 1
    return occurrences, total

# Question 4 :

def normaliser(occurences, total):
    for clé in occurences :
        occurences[clé]=occurences[clé]/total

# Question 5 :

def calculer_mse(reference_freqs, texte_freqs, chaine):
    for langue in reference_freqs:
        ref = reference_freqs[langue]
        if chaine is None:
            caracteres = list(ref.keys())
        else:
            caracteres = chaine
        somme = 0
        for c in caracteres:
            observee = texte_freqs.get(c, 0)     # 0 si la lettre est absente du texte
            attendue = ref.get(c, 0)
            somme += (observee - attendue) ** 2
        resultat.append((langue, somme / len(caracteres)))
    return resultat

# Question 6 :

def score_du_couple(couple):
    return couple[1]

def trier_mse(mse):
    """Trie sur place par score croissant : la meilleure langue est en mse[0]."""
    mse.sort(key=score_du_couple)

